# WizardView Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ======================
# REQUIRED in Production
# ======================

# Flask secret key for session security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-me

# Linear API configuration
LINEAR_API_KEY=lin_api_your-key-here
LINEAR_TEAM_ID=ENG

# Application URL (for Linear links back to WizardView)
WIZARDVIEW_URL=https://your-app.onrender.com

# ======================
# Authentication
# ======================

# Login credentials (in production, consider using SSO or database)
AUTH_USERNAME=your-email@example.com
AUTH_PASSWORD=your-secure-password

# ======================
# Optional Configuration
# ======================

# Custom artifacts directory (defaults to uploads/extracted)
# ARTIFACTS_DIR=/path/to/artifacts

# Development only: Local sample scrolls path for testing
# DEV_ARTIFACTS_PATH=/path/to/local/scrolls

# Development only: Sample scrolls path for /api/use-sample endpoint
# SAMPLE_SCROLLS_PATH=/path/to/sample/scrolls

# Flask environment (set to 'production' in production)
# FLASK_ENV=production

# Server port (Render sets this automatically)
# PORT=5001

